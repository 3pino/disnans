<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- 通話: マイク（WebView の getUserMedia がアプリの許可を求める）と、通話中のフォアグラウンドサービス -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 通話の出力先に Bluetooth を選ぶ（Android 12 以降） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!--
          共有メニューに disnans を出す。MainActivity は tauri android init の生成物（gen/）なので触らず、
          マニフェストの統合で同じ名前の activity に intent-filter を足す。
          受け取りは NotifierPlugin（load / onNewIntent）。
        -->
        <activity android:name="dev.disnans.app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- remoteMessaging: メッセージを端末間で届けるための種類。dataSync と違い、時間の制限がなく、起動時にも開始できる -->
        <service
            android:name="dev.disnans.notifier.NotifyService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- microphone: 画面を消しても通話のマイクを使い続けるための種類 -->
        <service
            android:name="dev.disnans.notifier.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- BOOT_COMPLETED はシステムからしか送れないが、受け取るには exported が必要 -->
        <receiver
            android:name="dev.disnans.notifier.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
