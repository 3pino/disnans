<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.disnans.apkupdater" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>

        <!-- アプリ本体の FileProvider と衝突しないよう、専用のクラスと authority にする -->
        <provider
            android:name="dev.disnans.apkupdater.ApkFileProvider"
            android:authorities="dollar_openBracket_applicationId_closeBracket.apkupdater"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_updater_paths" />
        </provider>
    </application>

</manifest>