{
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-cli.mjs && npm run dev",
    "beforeBuildCommand": "node ../scripts/prepare-cli.mjs && npm run build"
  },
  "bundle": {
    "externalBin": [
      "binaries/disnans"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "disnans",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ]
  }
}
