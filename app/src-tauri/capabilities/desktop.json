{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "デスクトップ版のアップデート、通知、開発用フォルダを選ぶダイアログ、クリップボードの画像と文字（共有フォルダへの貼り付け）、最近の画像（ピクチャのフォルダ）の読み込み",
  "platforms": [
    "linux",
    "windows",
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "dialog:allow-open",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$PICTURE/**"
        }
      ]
    }
  ]
}
